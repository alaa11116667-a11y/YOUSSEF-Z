rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Registered students directory (Readable by all, writable on registration)
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    // Solutions to engineer questions submitted by students and graded by teacher
    match /engineer_submissions/{submissionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(submissionId);
    }

    // Exams (Educational content readable by all students)
    match /exams/{examId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(examId);
    }

    // Homework sheets
    match /homeworks/{homeworkId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(homeworkId);
    }

    // PDF summaries and formula books
    match /pdfs/{pdfId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(pdfId);
    }

    // Engineers high-level problems
    match /engineer_problems/{problemId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(problemId);
    }

    // Blackboard captures
    match /board_captures/{boardId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(boardId);
    }

    // Course announcements
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(announcementId);
    }

    // Student Exam Submissions & Teacher Grading
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(submissionId);
    }

    // Student Complaints & Feedback
    match /complaints/{complaintId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(complaintId);
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
